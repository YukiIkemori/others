{
  "hosting": {
    "public": "public",
    "ignore": [
      "**/.*",
      "pub_*.json",
      "publish_batches.json"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(webp|png|ogg|mp3|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/pv/dl/**",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment"
          }
        ]
      }
    ]
  }
}